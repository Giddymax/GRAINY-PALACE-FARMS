# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://grainypalacefarm.com

# ── Paystack (Ghana Mobile Money + cards) ───────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WhatsApp ordering ────────────────────────────────────────────────────
# Digits only, country code first, no leading +. Overrides the site_content default.
NEXT_PUBLIC_WHATSAPP_NUMBER=233201234567

# ── Web Push (Phase 7 — optional, opt-in order/article notifications) ────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Analytics (optional) ─────────────────────────────────────────────────
NEXT_PUBLIC_VERCEL_ANALYTICS=false
